# Grav runtime (keep folder placeholders)
/cache/*
!/cache/.gitkeep
/logs/*
!/logs/.gitkeep
/tmp/*
!/tmp/.gitkeep
/backup/*
!/backup/.gitkeep
/images/*
!/images/.gitkeep
/assets/*
!/assets/.gitkeep

# Per-environment secrets & accounts
/user/accounts/*.yaml
/user/data/*
!/user/data/.gitkeep
!/user/data/.htaccess
# MAW Builder: global sections and saved patterns are site content (commit them); revision history is per environment
!/user/data/maw-builder/
/user/data/maw-builder/revisions/
/user/data/maw-builder/**/.lock
/user/data/maw-builder/**/*.tmp
# MAW Menus: menus are site content (commit them)
!/user/data/maw-menus/
/user/data/maw-menus/**/.lock
/user/data/maw-menus/**/*.tmp
/user/config/security.yaml
.env
.mcp.json

# Tooling
node_modules/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Grav 2 per-site secrets (salts, API signing keys) — generated on first run, never commit
/user/config/*-private.php
/user/config/plugins/*-private.php

# Dev sandbox: junctions to the standalone repos in ../Grav_system (commit theme/builder changes there)
/user/themes/maw-starter
/user/plugins/maw-builder
/user/plugins/maw-menus

