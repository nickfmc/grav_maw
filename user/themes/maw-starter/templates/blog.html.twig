{#
  blog: listing of child `item` pages. Collection is defined in frontmatter `content:` (see blueprints/blog.yaml).
  Optional `blocks:` render above the listing (e.g. a hero), `blocks_after:` below it.
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
    {% set collection = page.collection() %}
    {% include 'blocks/_render.html.twig' with {blocks: page.header.blocks} %}

    <section class="page-body">
        <div class="container">
            {% if not page.header.hide_title %}
                <header class="page-header">
                    <h1>{{ page.title }}</h1>
                    {% if page.header.subtitle %}<p class="lead">{{ page.header.subtitle }}</p>{% endif %}
                    {% if page.content|trim %}<div class="prose">{{ page.content|raw }}</div>{% endif %}
                </header>
            {% endif %}

            {% set active_tag = uri.param('tag') %}
            {% if active_tag %}<p class="text-muted">Tagged: <span class="tag">{{ active_tag|e }}</span></p>{% endif %}

            <div class="grid grid--3">
                {% for item in collection %}
                    {% include 'partials/card-page.html.twig' with {item: item} %}
                {% else %}
                    <p class="text-muted">{{ 'THEME_MAW_STARTER.EMPTY'|t }}</p>
                {% endfor %}
            </div>

            {% if config.plugins.pagination.enabled and collection.params.pagination %}
                {% include 'partials/pagination.html.twig' with {base_url: page.url, pagination: collection.params.pagination} %}
            {% endif %}
        </div>
    </section>

    {% include 'blocks/_render.html.twig' with {blocks: page.header.blocks_after} %}
{% endblock %}
