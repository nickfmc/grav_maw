{#
  Shared UI macros. Import with:  {% import 'macros/ui.html.twig' as ui %}

  ui.head(block)                     eyebrow + heading + intro (markdown) as a .section-head
  ui.buttons(block.buttons)          list of {label, url, style: primary|secondary|ghost, icon, new_tab}
  ui.image(ref, page, opts)          responsive <img> from a media ref; opts: {width, height, alt, class, crop, eager, edit}
  ui.rich(text, wide, edit)          markdown string -> HTML inside .prose; `edit` = field path for inline editing
#}

{% macro head(block, level) %}
    {% set level = level|default(block.heading_level|default(2)) %}
    {% if block.eyebrow or block.heading or block.intro %}
        <header class="section-head">
            {% if block.eyebrow %}<span class="eyebrow"{{ maw_edit('eyebrow') }}>{{ block.eyebrow }}</span>{% endif %}
            {% if block.heading %}<h{{ level }}{{ maw_edit('heading') }}>{{ block.heading }}</h{{ level }}>{% endif %}
            {% if block.intro %}<div class="lead"{{ maw_edit_md('intro', true) }}>{{ block.intro|markdown(false)|raw }}</div>{% endif %}
        </header>
    {% endif %}
{% endmacro %}

{% macro buttons(buttons, size) %}
    {# Loop the original list (not a filtered copy) so inline-edit paths keep each button's real index. #}
    {% set buttons = buttons|default([]) %}
    {% if buttons|filter(b => b.label and b.url)|length %}
        <div class="button-row"{{ maw_edit_list('buttons', 'button') }}>
            {% for b in buttons %}{% if b.label and b.url %}
                <a{{ maw_edit_item(loop.index0) }} class="btn btn-{{ b.style|default(loop.first ? 'primary' : 'secondary')|maw_slug }}{{ size ? ' btn-' ~ size }}"
                   href="{{ b.url|e }}"{% if b.new_tab %} target="_blank" rel="noopener"{% endif %}>
                    {% if b.icon %}<i class="{{ b.icon|fa_icon }}" aria-hidden="true"></i>{% endif %}
                    <span{{ maw_edit('buttons.' ~ loop.index0 ~ '.label') }}>{{ b.label }}</span>
                </a>
            {% endif %}{% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% macro image(ref, page, opts) %}
    {% set opts = opts|default({}) %}
    {% set m = maw_media(ref, page) %}
    {% set alt = opts.alt|default('') %}
    {% set cls = opts.class|default('') %}
    {# opts.edit = field path: click-to-replace in the builder preview (wrapper has no box, so layout is unchanged) #}
    {% set edit_attr = opts.edit|default(null) ? maw_edit_image(opts.edit) : '' %}
    {% if edit_attr %}<span style="display: contents"{{ edit_attr|raw }}>{% endif %}
    {% if m is maw_medium %}
        {% if m.mime == 'image/svg+xml' or m.type != 'image' %}
            <img src="{{ m.url }}" alt="{{ alt|e }}" class="{{ cls }}" loading="{{ opts.eager ? 'eager' : 'lazy' }}">
        {% else %}
            {% set w = opts.width|default(1200) %}
            {% if opts.height and opts.crop is not same as(false) %}
                {% set m = m.cropZoom(w, opts.height) %}
            {% else %}
                {% set m = m.cropResize(w, w * 2) %}
            {% endif %}
            {{ m.derivatives(360, w, 360).sizes(opts.sizes|default('(max-width: 860px) 100vw, 50vw')).loading(opts.eager ? 'eager' : 'lazy').html('', alt, cls)|raw }}
        {% endif %}
    {% elseif m %}
        <img src="{{ m|e }}" alt="{{ alt|e }}" class="{{ cls }}" loading="{{ opts.eager ? 'eager' : 'lazy' }}">
    {% elseif opts.placeholder is not same as(false) %}
        <div class="media-placeholder {{ cls }}" role="presentation"></div>
    {% endif %}
    {% if edit_attr %}</span>{% endif %}
{% endmacro %}

{% macro rich(text, wide, edit) %}
    {% if text %}<div class="prose{{ wide ? ' prose--wide' }}"{{ edit ? maw_edit_md(edit) }}>{{ text|markdown|raw }}</div>{% endif %}
{% endmacro %}
