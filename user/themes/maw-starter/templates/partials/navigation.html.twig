{#
  Primary navigation: visible top-level pages (+ one dropdown level), then site.yaml `menu:` items.
  Hide a page from nav with `visible: false` in its frontmatter.
#}
{% macro nav_items(items, depth) %}
    {% for p in items|filter(p => p.visible and p.routable) %}
        {% set children = p.children.visible %}
        <li class="{{ p.activeChild ? 'is-active' }}">
            <a href="{{ p.url }}" {{ p.active ? 'aria-current="page"' }}>{{ p.menu }}</a>
            {% if depth < 2 and children|length and p.header.nav_children is not same as(false) and p.template() != 'blog' %}
                <ul>{{ _self.nav_items(children, depth + 1) }}</ul>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}

<ul class="nav-list">
    {{ _self.nav_items(pages.children.visible, 1) }}
    {% for item in site.menu|default([]) %}
        <li><a href="{{ item.url|e }}" {{ item.external ? 'target="_blank" rel="noopener"' }}>{{ item.text }}</a></li>
    {% endfor %}
</ul>
