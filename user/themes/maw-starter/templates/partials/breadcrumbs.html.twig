{# Built-in breadcrumbs (no plugin needed). Skipped on the home page. #}
{% if not page.home %}
    {% set trail = [] %}
    {% set p = page.parent %}
    {% for i in 1..6 %}
        {% if p and p.routable and not p.root %}
            {% set trail = [p]|merge(trail) %}
            {% set p = p.parent %}
        {% endif %}
    {% endfor %}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="{{ home_url }}">{{ 'THEME_MAW_STARTER.HOME'|t }}</a></li>
            {% for crumb in trail|filter(c => not c.home) %}
                <li><a href="{{ crumb.url }}">{{ crumb.menu }}</a></li>
            {% endfor %}
            <li aria-current="page">{{ page.menu }}</li>
        </ol>
    </nav>
{% endif %}
