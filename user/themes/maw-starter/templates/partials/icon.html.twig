{#
  Inline SVG icons that must work without Font Awesome (UI chrome).
  Usage: {% include 'partials/icon.html.twig' with {name: 'arrow-right', size: 18} %}
  Content icons (features, social) use Font Awesome via the `fa_icon` filter instead.
#}
{% set s = size|default(20) %}
{% set paths = {
    'menu':        '<path d="M4 6h16M4 12h16M4 18h16"/>',
    'close':       '<path d="M6 6l12 12M18 6L6 18"/>',
    'sun':         '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
    'moon':        '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
    'arrow-right': '<path d="M5 12h14M13 5l7 7-7 7"/>',
    'check':       '<path d="M20 6L9 17l-5-5"/>',
    'chevron-down':'<path d="M6 9l6 6 6-6"/>',
    'plus':        '<path d="M12 5v14M5 12h14"/>',
    'quote':       '<path d="M7 7h4v4c0 3-1.5 5-4 6M15 7h4v4c0 3-1.5 5-4 6"/>',
    'play':        '<path d="M8 5v14l11-7z"/>'
} %}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ (paths[name] ?? '')|raw }}</svg>
