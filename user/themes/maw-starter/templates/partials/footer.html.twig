{% set footer = theme_var('footer') ?: {} %}
<footer class="site-footer">
    <div class="container site-footer__inner">
        <div class="stack" style="--stack-gap: var(--maw-space-2)">
            {% include 'partials/logo.html.twig' %}
            {% if footer.text %}<div>{{ footer.text|markdown(false)|raw }}</div>{% endif %}
            <p>&copy; {{ 'now'|date('Y') }} {{ site.title }}</p>
        </div>

        {% if footer.links %}
            <nav aria-label="{{ 'THEME_MAW_STARTER.NAV.FOOTER'|t }}">
                <ul class="footer-links">
                    {% for link in footer.links %}
                        <li><a href="{{ link.url|e }}">{{ link.label }}</a></li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}

        {% if footer.social %}
            <ul class="footer-social">
                {% for s in footer.social %}
                    <li><a href="{{ s.url|e }}" rel="noopener" aria-label="{{ s.label|e }}">
                        {% if s.icon and theme_var('fontawesome') %}<i class="{{ s.icon|fa_icon }}" aria-hidden="true"></i>{% else %}{{ s.label }}{% endif %}
                    </a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</footer>
