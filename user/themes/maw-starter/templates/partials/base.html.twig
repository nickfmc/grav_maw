{#
  Page shell. Every page template extends this file.
  Blocks you can override in a child template:
    head_extra, stylesheets, javascripts, header, hero, content, footer, bottom
  The main content MUST stay inside <main id="content"> so Grav's Markdown output (page.md) finds it.
#}
{% set brand = theme_var('brand') ?: {} %}
{% set accent = brand.accent ?? '' %}
{% set accent_ok = accent and accent matches '/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/' %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang ?: 'en' }}"
      data-theme-default="{{ theme_var('theme_mode') ?: 'auto' }}"
      data-radius="{{ brand.radius ?? 'md' }}">
<head>
{% block head deferred %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% if page.title and not page.home %}{{ page.title|e }} | {% endif %}{{ site.title|e }}</title>

    {% include 'partials/metadata.html.twig' %}
    {% include 'partials/seo.html.twig' %}
    <link rel="canonical" href="{{ page.url(true, true) }}">
    {% if url('theme://images/favicon.svg') %}<link rel="icon" href="{{ url('theme://images/favicon.svg') }}" type="image/svg+xml">{% endif %}

    <style>
      :root {
        {% if accent_ok %}--maw-accent: {{ accent }};{% endif %}
        {% if brand.container %}--maw-container: {{ brand.container|e('css') }};{% endif %}
        {% set css_unsafe = {'<': '', '>': '', ';': '', '{': '', '}': '', '\\': ''} %}
        {% if brand.font_body %}--maw-font-body: {{ brand.font_body|replace(css_unsafe)|raw }};{% endif %}
        {% if brand.font_heading and brand.font_heading != 'inherit' %}--maw-font-heading: {{ brand.font_heading|replace(css_unsafe)|raw }};{% endif %}
      }
    </style>

    {# Pre-paint color mode, avoids a flash of the wrong theme #}
    <script>
      (function () {
        var d = document.documentElement, pref;
        d.classList.add('js');
        try { pref = localStorage.getItem('maw-theme'); } catch (e) {}
        pref = pref || d.getAttribute('data-theme-default');
        if (pref === 'auto' || !pref) pref = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', pref);
      })();
    </script>
    {% block head_extra %}{% endblock %}
{% endblock head %}

{% block stylesheets %}
    {% if brand.google_fonts starts with 'https://fonts.googleapis.com/' %}
        {% do assets.addCss(brand.google_fonts, 110) %}
    {% endif %}
    {% do assets.addCss('theme://css/tokens.css', 100) %}
    {% do assets.addCss('theme://css/base.css', 99) %}
    {% do assets.addCss('theme://css/layout.css', 98) %}
    {% do assets.addCss('theme://css/components.css', 97) %}
    {% do assets.addCss('theme://css/utilities.css', 96) %}
    {% if theme_var('fontawesome') %}
        {% do assets.addCss('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css', 90) %}
    {% endif %}
    {# Block CSS (priority 50) is added by blocks/_section.html.twig only for blocks on this page #}
    {% do assets.addCss('theme://css/custom.css', 1) %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('theme://js/site.js', {group: 'bottom', priority: 100, loading: 'defer'}) %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
</head>
<body class="{{ body_class(['template-' ~ page.template()]) }} {{ page.header.body_classes }}">
    <a class="skip-link" href="#content">{{ 'THEME_MAW_STARTER.SKIP'|t }}</a>

    {% block header %}
        {% include 'partials/header.html.twig' %}
    {% endblock %}

    <main id="content" class="site-main" tabindex="-1">
        {% block hero %}{% endblock %}
        {% block messages %}{% include 'partials/messages.html.twig' ignore missing %}{% endblock %}
        {% block content %}{% endblock %}
    </main>

    {% block footer %}
        {% include 'partials/footer.html.twig' %}
    {% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}
</body>
</html>
