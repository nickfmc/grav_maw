{#
  blocks: a page built entirely from the `blocks:` list in frontmatter (landing pages, home, services...).
  The Markdown body (if any) renders as a rich-text section at `content_position` (top|bottom|none, default top).
  See docs/ai/content-model.md and blueprints/blocks/*.yaml for every block's fields.
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
    {% set position = page.header.content_position|default('top') %}
    {% set body = page.content|trim %}
    {% if body and position == 'top' %}
        {% include 'blocks/rich-text.html.twig' with {block: {type: 'rich-text', html: page.content}} %}
    {% endif %}

    {% include 'blocks/_render.html.twig' with {blocks: page.header.blocks} %}

    {% if body and position == 'bottom' %}
        {% include 'blocks/rich-text.html.twig' with {block: {type: 'rich-text', html: page.content}} %}
    {% endif %}
{% endblock %}
