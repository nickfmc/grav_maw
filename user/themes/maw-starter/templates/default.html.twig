{#
  default: a normal content page. Title + Markdown body, then any `blocks:` from frontmatter.
  Frontmatter options: hide_title, subtitle, breadcrumbs (bool), width (narrow|default|wide), blocks: [...]
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
    {% set width = page.header.width|default('narrow') %}
    {% if page.content|trim or not page.header.hide_title %}
    <article class="page-body">
        <div class="container{{ width != 'default' ? ' container--' ~ width|maw_slug }}">
            {% if page.header.breadcrumbs is not same as(false) %}{% include 'partials/breadcrumbs.html.twig' %}{% endif %}
            {% if not page.header.hide_title %}
                <header class="page-header">
                    <h1>{{ page.title }}</h1>
                    {% if page.header.subtitle %}<p class="lead">{{ page.header.subtitle }}</p>{% endif %}
                </header>
            {% endif %}
            <div class="prose{{ width == 'wide' ? ' prose--wide' }}">{{ page.content|raw }}</div>
        </div>
    </article>
    {% endif %}
    {% include 'blocks/_render.html.twig' with {blocks: page.header.blocks} %}
{% endblock %}
