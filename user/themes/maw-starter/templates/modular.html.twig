{#
  modular: classic Grav modular page. Each child `_module` folder renders its own template
  (modular/<block-type>.html.twig), which reuses the same block partials as the `blocks` template.
  Prefer the `blocks` template for new pages; modular is supported for teams that like one folder per section.
#}
{% extends 'partials/base.html.twig' %}

{% block content %}
    {% for module in page.collection()|filter(m => m.header.visible is not same as(false)) %}
        {{ module.content|raw }}
    {% endfor %}
{% endblock %}
