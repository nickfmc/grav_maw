{% embed 'blocks/_section.html.twig' %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <div class="grid grid--{{ block.columns|default(min(3, block.items|default([])|length ?: 1)) }} pricing"{{ maw_edit_list('items', 'plan') }}>
            {% for plan in block.items|default([]) %}
                <article class="card plan{{ plan.featured ? ' plan--featured' }}"{{ maw_edit_item(loop.index0) }}>
                    <div class="card__body">
                        {% if plan.badge %}<span class="plan__badge"{{ maw_edit('items.' ~ loop.index0 ~ '.badge') }}>{{ plan.badge }}</span>{% endif %}
                        <h3 class="plan__name"{{ maw_edit('items.' ~ loop.index0 ~ '.name') }}>{{ plan.name }}</h3>
                        <p class="plan__price"><span class="plan__amount"{{ maw_edit('items.' ~ loop.index0 ~ '.price') }}>{{ plan.price }}</span>{% if plan.period %} <span class="plan__period"{{ maw_edit('items.' ~ loop.index0 ~ '.period') }}>{{ plan.period }}</span>{% endif %}</p>
                        {% if plan.description %}<p class="card__text"{{ maw_edit('items.' ~ loop.index0 ~ '.description') }}>{{ plan.description }}</p>{% endif %}
                        {% if plan.features %}
                            <ul class="checklist">
                                {% for line in plan.features|split("\n")|map(l => l|trim)|filter(l => l) %}
                                    <li>{% include 'partials/icon.html.twig' with {name: 'check', size: 18} %}<span>{{ line }}</span></li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if plan.button_label and plan.button_url %}
                            <a class="btn {{ plan.featured ? 'btn-primary' : 'btn-secondary' }} plan__button" href="{{ plan.button_url|e }}"><span{{ maw_edit('items.' ~ loop.index0 ~ '.button_label') }}>{{ plan.button_label }}</span></a>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
