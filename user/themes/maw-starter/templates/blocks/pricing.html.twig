{% embed 'blocks/_section.html.twig' %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <div class="grid grid--{{ block.columns|default(min(3, block.items|default([])|length ?: 1)) }} pricing">
            {% for plan in block.items|default([]) %}
                <article class="card plan{{ plan.featured ? ' plan--featured' }}">
                    <div class="card__body">
                        {% if plan.badge %}<span class="plan__badge">{{ plan.badge }}</span>{% endif %}
                        <h3 class="plan__name">{{ plan.name }}</h3>
                        <p class="plan__price"><span class="plan__amount">{{ plan.price }}</span>{% if plan.period %} <span class="plan__period">{{ plan.period }}</span>{% endif %}</p>
                        {% if plan.description %}<p class="card__text">{{ plan.description }}</p>{% endif %}
                        {% if plan.features %}
                            <ul class="checklist">
                                {% for line in plan.features|split("\n")|map(l => l|trim)|filter(l => l) %}
                                    <li>{% include 'partials/icon.html.twig' with {name: 'check', size: 18} %}<span>{{ line }}</span></li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if plan.button_label and plan.button_url %}
                            <a class="btn {{ plan.featured ? 'btn-primary' : 'btn-secondary' }} plan__button" href="{{ plan.button_url|e }}">{{ plan.button_label }}</a>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
