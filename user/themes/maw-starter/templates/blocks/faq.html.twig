{% set items = block.items|default([])|filter(i => i.question) %}
{% embed 'blocks/_section.html.twig' with {default_width: 'narrow'} %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <div class="faq"{{ maw_edit_list('items', 'question') }}>
            {# Loop the original list so inline-edit paths keep each question's real index. #}
            {% for item in block.items|default([]) %}{% if item.question %}
                <details class="faq__item"{{ maw_edit_item(loop.index0) }}{% if loop.first and block.open_first %} open{% endif %}>
                    <summary><span{{ maw_edit('items.' ~ loop.index0 ~ '.question') }}>{{ item.question }}</span>{% include 'partials/icon.html.twig' with {name: 'plus', size: 18} %}</summary>
                    <div class="prose faq__answer"{{ maw_edit_md('items.' ~ loop.index0 ~ '.answer') }}>{{ item.answer|markdown|raw }}</div>
                </details>
            {% endif %}{% endfor %}
        </div>
        {% if block.schema is not same as(false) and items|length %}
            {% set ld = {'@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': items|map(i => {
                '@type': 'Question', 'name': i.question,
                'acceptedAnswer': {'@type': 'Answer', 'text': i.answer|markdown|striptags}
            })} %}
            <script type="application/ld+json">{{ ld|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}</script>
        {% endif %}
    {% endblock %}
{% endembed %}
