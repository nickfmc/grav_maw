{% embed 'blocks/_section.html.twig' with {default_spacing: 'sm'} %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {% if block.heading %}<p class="logos__heading"{{ maw_edit('heading') }}>{{ block.heading }}</p>{% endif %}
        <ul class="logos"{{ maw_edit_list('items', 'logo') }}>
            {% for logo in block.items|default([]) %}
                <li class="logos__item"{{ maw_edit_item(loop.index0) }}>
                    {% if logo.url %}<a href="{{ logo.url|e }}" rel="noopener">{% endif %}
                    {% if logo.image %}
                        {{ ui.image(logo.image, media_owner ?? page, {alt: logo.name, width: 320, placeholder: false, sizes: '160px', edit: 'items.' ~ loop.index0 ~ '.image'}) }}
                    {% else %}
                        <span class="logos__name"{{ maw_edit('items.' ~ loop.index0 ~ '.name') }}>{{ logo.name }}</span>
                    {% endif %}
                    {% if logo.url %}</a>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endembed %}
