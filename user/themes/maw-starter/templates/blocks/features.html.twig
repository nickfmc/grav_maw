{% embed 'blocks/_section.html.twig' %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <div class="grid grid--{{ block.columns|default(3) }} features features--{{ block.style|default('plain')|maw_slug }}"{{ maw_edit_list('items', 'feature') }}>
            {% for item in block.items|default([]) %}
                {% set tag = item.url ? 'a' : 'div' %}
                <{{ tag }}{{ maw_edit_item(loop.index0) }} class="feature{{ block.style == 'cards' ? ' card card__body' }}"{% if item.url %} href="{{ item.url|e }}"{% endif %}>
                    {% if item.icon and theme_var('fontawesome') %}
                        <span class="icon-badge"><i class="{{ item.icon|fa_icon }}" aria-hidden="true"></i></span>
                    {% endif %}
                    {% if item.title %}<h3 class="feature__title"{{ maw_edit('items.' ~ loop.index0 ~ '.title') }}>{{ item.title }}</h3>{% endif %}
                    {% if item.text %}<div class="feature__text"{{ maw_edit_md('items.' ~ loop.index0 ~ '.text', true) }}>{{ item.text|markdown(false)|raw }}</div>{% endif %}
                </{{ tag }}>
            {% endfor %}
        </div>
        {{ ui.buttons(block.buttons) }}
    {% endblock %}
{% endembed %}
