{% embed 'blocks/_section.html.twig' %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <dl class="stats grid grid--{{ block.columns|default(min(4, block.items|default([])|length ?: 1)) }}"{{ maw_edit_list('items', 'stat') }}>
            {% for item in block.items|default([]) %}
                <div class="stat"{{ maw_edit_item(loop.index0) }}>
                    <dt class="stat__label"{{ maw_edit('items.' ~ loop.index0 ~ '.label') }}>{{ item.label }}</dt>
                    <dd class="stat__value"{{ maw_edit('items.' ~ loop.index0 ~ '.value') }}>{{ item.value }}</dd>
                    {% if item.text %}<dd class="stat__text"{{ maw_edit('items.' ~ loop.index0 ~ '.text') }}>{{ item.text }}</dd>{% endif %}
                </div>
            {% endfor %}
        </dl>
    {% endblock %}
{% endembed %}
