{% embed 'blocks/_section.html.twig' %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <dl class="stats grid grid--{{ block.columns|default(min(4, block.items|default([])|length ?: 1)) }}">
            {% for item in block.items|default([]) %}
                <div class="stat">
                    <dt class="stat__label">{{ item.label }}</dt>
                    <dd class="stat__value">{{ item.value }}</dd>
                    {% if item.text %}<dd class="stat__text">{{ item.text }}</dd>{% endif %}
                </div>
            {% endfor %}
        </dl>
    {% endblock %}
{% endembed %}
