{% embed 'blocks/_section.html.twig' %}
    {% block inner %}
        {% import 'macros/ui.html.twig' as ui %}
        {{ ui.head(block) }}
        <div class="grid grid--{{ block.columns|default(min(3, block.items|default([])|length ?: 1)) }}"{{ maw_edit_list('items', 'testimonial') }}>
            {% for item in block.items|default([]) %}
                <figure class="testimonial card card__body"{{ maw_edit_item(loop.index0) }}>
                    <blockquote class="testimonial__quote"{{ maw_edit_md('items.' ~ loop.index0 ~ '.quote', true) }}>{{ item.quote|markdown(false)|raw }}</blockquote>
                    <figcaption class="testimonial__author">
                        {% if item.image %}{{ ui.image(item.image, media_owner ?? page, {alt: '', width: 96, height: 96, class: 'testimonial__avatar', placeholder: false, sizes: '48px', edit: 'items.' ~ loop.index0 ~ '.image'}) }}{% endif %}
                        <span><strong{{ maw_edit('items.' ~ loop.index0 ~ '.name') }}>{{ item.name }}</strong>{% if item.role %}<br><span class="text-muted"{{ maw_edit('items.' ~ loop.index0 ~ '.role') }}>{{ item.role }}</span>{% endif %}</span>
                    </figcaption>
                </figure>
            {% endfor %}
        </div>
    {% endblock %}
{% endembed %}
